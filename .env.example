# Copy to .env and load with:  set -a; source .env; set +a      (the project does not auto-load .env)

# Option A - fully local (no API key)
RAG_EMBEDDINGS=huggingface            # sentence-transformers/all-MiniLM-L6-v2
RAG_LLM=huggingface                   # Qwen/Qwen2.5-1.5B-Instruct  (use a 3B/7B model for the agent)
# RAG_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Option B - Ollama (ollama pull nomic-embed-text && ollama pull qwen2.5:7b)
# RAG_EMBEDDINGS=ollama
# RAG_LLM=ollama
# RAG_LLM_MODEL=qwen2.5:7b

# Option C - OpenAI (also export OPENAI_API_KEY)
# RAG_EMBEDDINGS=openai
# RAG_LLM=openai

# Optional tuning
# RAG_CHUNK_SIZE=350
# RAG_CHUNK_OVERLAP=50
# RAG_TOP_K=4
